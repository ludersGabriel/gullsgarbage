# Host port the app is published on. docker-compose.yml maps ${PORT} to the
# container's internal port 3000 (Nitro bun preset). The dev server keeps its
# own port 3000 (vite.config.ts) and is unaffected by this value.
PORT=3077

# Compose project name — prefixes networks/volumes. Kept stable on purpose;
# do not "fix" it to the repo name.
COMPOSE_PROJECT_NAME=gullsgarbage

# Public origin the app is served on (exact origin, no trailing slash).
# NOT read by the app yet — kept accurate so it is right the day auth or a
# canonical-URL helper needs it, mirroring ld-clinica's PUBLIC_URL.
PUBLIC_URL=https://gullsgarba.ge
